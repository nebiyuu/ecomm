# Server
PORT=5000

# Database (host points to wherever Postgres actually runs)
DB_HOST=<your-db-host>
DB_PORT=5432
DB_NAME=<your-db-name>
DB_USER=<your-db-user>
DB_PASS=<your-db-password>

# JWT
JWT_SECRET=<long-random-secret>
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-email@gmail.com>
SMTP_PASS=<your-app-password>

# Chapa payment (name is read by the code as CHAPA_SECRET_KEY)
CHAPA_SECRET_KEY=<your-chapa-secret-key>

# URLs
BASE_URL=<https://your-api-domain>
FRONTEND_URL=<https://your-frontend-domain>
BACKEND_URL=<https://your-api-domain>

# Cloudinary
CLOUD_NAME=<your-cloud-name>
CLOUD_KEY=<your-api-key>
CLOUD_SECRET=<your-api-secret>
