[Unit]
Description=Rentry AI Microservice (FastAPI)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/rentry/Rentry-backend/rentry-ai-microservice
EnvironmentFile=/home/ubuntu/rentry/Rentry-backend/.env
ExecStart=/home/ubuntu/rentry/Rentry-backend/rentry-ai-microservice/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
StandardOutput=journal

[Install]
WantedBy=multi-user.target